# Copy to `.env` and fill in. Used by docker-compose.yml.
#
#   cp .env.example .env && docker compose up -d

# ---------------------------------------------------------------------------
# WHICH FRONT ENDS TO RUN
#
# The API and database are always deployed. These two profiles select the DEFAULT front ends; remove
# one when you're replacing it with your own. See DEPLOY.md, "Choosing your front ends".
#
#   web,admin   the whole product (default)
#   web         our redirect site, your own dashboard
#   admin       our dashboard, your own redirect handler
#   (empty)     API only — you supply both
#
# ⚠️ Removing `web` stops short links from resolving: it is the only app that serves /{code}, and the
#    API has no redirect route. Only drop it if something else is answering those URLs.
# ⚠️ Removing `admin` drops the QR and CSV export endpoints, and its own dashboard pages — not the
#    social OAuth flow, which lives in Core's SocialOAuthController regardless of whether Admin runs.
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=web,admin

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_DB=shortlynx
POSTGRES_USER=shortlynx
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Secrets — generate each independently, e.g. `openssl rand -base64 32`
# ---------------------------------------------------------------------------
# Signs session JWTs. Core refuses to start without it.
JWT_SIGNING_KEY=
# Hashes API keys at rest.
API_KEY_HMAC_SECRET=
# Guards the admin-only key-provisioning endpoint.
API_KEY_ADMIN_SECRET=

# Pepper for the HMAC that hashes visitor IPs. This is the secret that keeps stored click data
# pseudonymous rather than reversible — without it, the ~4 billion IPv4 addresses are trivially
# brute-forced back out of the hashes. Core and Web MUST share the same value; if they differ, the
# same visitor hashes differently in each and unique-clicker counts silently double-count.
IP_HASH_PEPPER=

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------
# Bootstrap owner. On a fresh install this is the only address that can request a sign-in link — no
# existing admin exists to invite the first one, so it is allowlisted by config instead.
ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Email (magic-link sign-in). Without these, no sign-in link can be delivered.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# ---------------------------------------------------------------------------
# Observability — both entirely optional. Leave blank and every app behaves exactly as if this whole
# section didn't exist: console logging only, no outbound telemetry at all.
# ---------------------------------------------------------------------------
# Error tracking (sentry.io, free tier). Same DSN can be reused across all four apps, or give each its
# own Sentry project if you want them told apart there.
SENTRY_DSN=
# Structured log shipping (axiom.co, free tier). Both required together — set one without the other and
# it's treated the same as unset.
AXIOM_API_TOKEN=
AXIOM_DATASET=

# ---------------------------------------------------------------------------
# URLs
# ---------------------------------------------------------------------------
# Where short links are served from — used when building copyable URLs.
SHORT_BASE_URL=http://localhost:5071

# Where a magic link lands. This is a SINGLE value for the whole deployment, so it points at exactly
# one dashboard. Running the default admin and your own front end at once means choosing which of them
# owns sign-in; the other is reachable only by an already-signed-in session.
MAGIC_LINK_CONFIRM_URL=http://localhost:5201/auth/confirm

# Origin of a front end you supply, so the API accepts its credentialed requests. Leave empty when you
# run only the bundled apps. A cross-origin front end also needs Jwt__CookieSameSite=None on the API.
FRONTEND_ORIGIN=

# Optional — unset (the default) means an unknown/expired short code returns a plain 404, exactly
# today's behavior. Set this to send those visitors somewhere instead (e.g. your marketing site).
NOT_FOUND_REDIRECT_URL=

# ---------------------------------------------------------------------------
# Host ports
# ---------------------------------------------------------------------------
CORE_PORT=5129
WEB_PORT=5071
ADMIN_PORT=5201
