@page "/folders"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using Microsoft.Extensions.DependencyInjection
@using ShortLynx.Services.Folders
@inject IServiceScopeFactory ScopeFactory
@inject IDbContextFactory<ShortLynxDbContext> DbFactory

<PageTitle>Folders — ShortLynx Admin</PageTitle>

<div class="flex justify-between items-center mb-3">
    <h1 class="text-2xl font-bold">Folders</h1>
    @if (_canWrite)
    {
        <button class="btn btn-primary" data-testid="new-folder" @onclick="() => _showAdd = !_showAdd">
            @(_showAdd ? "Cancel" : "+ New folder")
        </button>
    }
</div>

<p class="text-gray-500 text-sm mb-3 max-w-[640px]">
    Pure organization — a collection of related shortlinks, browsable and filterable together. Unlike a
    campaign, a folder never affects redirect behavior (no UTM template). Assign a link to a folder
    from its detail page.
</p>

@if (_showAdd)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">New folder</h5>
            <EditForm Model="_form" OnValidSubmit="Create">
                <DataAnnotationsValidator/>
                <div class="mb-2">
                    <label class="field-label">Name</label>
                    <InputText class="field-input" @bind-Value="_form.Name" data-testid="name-input"/>
                    <ValidationMessage For="() => _form.Name"/>
                </div>
                @if (_addError is not null)
                {
                    <div class="text-red-600 text-sm mb-2" data-testid="add-error">@_addError</div>
                }
                <button type="submit" class="btn btn-primary" data-testid="add-submit">Create folder</button>
            </EditForm>
        </div>
    </div>
}

@if (!_loaded)
{
    <p class="text-gray-500">Loading…</p>
}
else if (_folders.Count == 0)
{
    <p class="text-gray-500" data-testid="empty">No folders yet.</p>
}
else
{
    <div class="flex flex-col gap-3">
        @foreach (var f in _folders)
        {
            <div class="card" data-testid="folder-row">
                <div class="card-body">
                    @if (_editingId == f.Id)
                    {
                        <EditForm Model="_edit" OnValidSubmit="SaveEdit">
                            <DataAnnotationsValidator/>
                            <div class="mb-2">
                                <label class="field-label">Name</label>
                                <InputText class="field-input" @bind-Value="_edit.Name" data-testid="edit-name-input"/>
                                <ValidationMessage For="() => _edit.Name"/>
                            </div>
                            <div class="flex gap-2">
                                <button type="submit" class="btn btn-primary" data-testid="edit-save">Save</button>
                                <button type="button" class="btn btn-outline" @onclick="() => _editingId = null">Cancel</button>
                            </div>
                        </EditForm>
                    }
                    else
                    {
                        <div class="flex items-center gap-2">
                            <span class="font-semibold">@f.Name</span>
                            <span class="badge badge-gray" data-testid="link-count">@f.LinkCount link@(f.LinkCount == 1 ? "" : "s")</span>
                            <div class="ml-auto flex gap-2">
                                <a class="btn btn-outline-primary" href="/folders/@f.Id" data-testid="view-analytics">Analytics</a>
                                @if (_canWrite)
                                {
                                    <button class="btn btn-outline" data-testid="edit-btn" @onclick="() => BeginEdit(f)">Edit</button>
                                    <button class="btn btn-outline-danger" data-testid="remove-btn" disabled="@_busy" @onclick="() => Remove(f.Id)">Delete</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    bool _loaded, _resolved, _showAdd, _busy, _canWrite;
    Guid _uid, _accountId;
    Guid? _editingId;
    List<FolderRow> _folders = [];
    readonly FolderForm _form = new();
    readonly FolderForm _edit = new();
    string? _addError;

    protected override async Task OnInitializedAsync()
    {
        var principal = (await AuthState).User;
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var ctx = await AccountRoleContext.ResolveAsync(db, principal);
            if (ctx is null) { _loaded = true; return; }
            (_uid, _accountId, _canWrite) = (ctx.UserId, ctx.AccountId, ctx.CanManageResources);
        }
        _resolved = true;
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        if (!_resolved) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var counts = await db.LinkEntities
            .Where(l => l.AccountId == _accountId && l.FolderId != null)
            .GroupBy(l => l.FolderId!.Value)
            .Select(g => new { g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.Key, x => x.Count);

        await using var scope = ScopeFactory.CreateAsyncScope();
        var svc = scope.ServiceProvider.GetRequiredService<IFolderService>();
        var list = await svc.ListAsync(_accountId);
        _folders = list.Select(f => new FolderRow(f.Id, f.Name, counts.GetValueOrDefault(f.Id, 0))).ToList();
        _loaded = true;
    }

    async Task Create()
    {
        // Handler-level guard, not just hidden UI — Blazor Server executes handlers regardless of markup.
        if (!_resolved || !_canWrite) return;
        _addError = null;
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var svc = scope.ServiceProvider.GetRequiredService<IFolderService>();
            await svc.CreateAsync(_accountId, _form.ToInput(), _uid);
            _form.Reset();
            _showAdd = false;
            await LoadAsync();
        }
        catch (ArgumentException ex) { _addError = ex.Message; }
    }

    void BeginEdit(FolderRow f)
    {
        if (!_canWrite) return;
        _editingId = f.Id;
        _edit.Name = f.Name;
    }

    async Task SaveEdit()
    {
        if (!_canWrite || _editingId is not { } id) return;
        await using var scope = ScopeFactory.CreateAsyncScope();
        var svc = scope.ServiceProvider.GetRequiredService<IFolderService>();
        await svc.UpdateAsync(id, _accountId, _edit.ToInput());
        _editingId = null;
        await LoadAsync();
    }

    async Task Remove(Guid id)
    {
        if (!_canWrite) return;
        _busy = true;
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var svc = scope.ServiceProvider.GetRequiredService<IFolderService>();
            await svc.DeleteAsync(id, _accountId);
            await LoadAsync();
        }
        finally { _busy = false; }
    }

    sealed class FolderForm
    {
        [Required(ErrorMessage = "Name is required.")]
        public string? Name { get; set; }

        public FolderInput ToInput() => new(Name ?? string.Empty);

        public void Reset() => Name = null;
    }

    sealed record FolderRow(Guid Id, string Name, int LinkCount);
}
